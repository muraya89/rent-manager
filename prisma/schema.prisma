  // This is your Prisma schema file,
  // learn more about it in the docs: https://pris.ly/d/prisma-schema

  // Get a free hosted Postgres database in seconds: `npx create-db`

  generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
  }

  datasource db {
    provider = "mysql"
  }

  model Property {
    id          Int      @id @default(autoincrement())
    name        String
    address     String
    monthlyRent Decimal 
    coverImageUrl      String? @db.VarChar(500)
    coverImagePublicId String? @db.VarChar(255)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    units       Unit[]
  }

  model Unit {
    id          Int      @id @default(autoincrement())
    propertyId  Int
    unitNumber  String
    monthlyRent Decimal
    defaultDeposit Decimal? @db.Decimal(12, 2)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    property    Property @relation(fields: [propertyId], references: [id])
    leases      Lease[]
  }

  model Tenant {
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    phone     String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    leases    Lease[]
  }

  enum LeaseStatus {
    ACTIVE
    EXPIRED
    TERMINATED
  }

  enum DepositTransactionType {
    RECEIVED
    DEDUCTION
    REFUND
  }

  model DepositTransaction {
  id         Int                    @id @default(autoincrement())
  leaseId    Int
  type       DepositTransactionType
  amount     Decimal                @db.Decimal(12, 2)
  reason     String?               
  occurredAt DateTime               @default(now())
  createdAt  DateTime               @default(now())

  lease      Lease                  @relation(fields: [leaseId], references: [id])

  @@index([leaseId])
}

model Lease {
  id                  Int                  @id @default(autoincrement())
  tenantId            Int
  unitId              Int
  startDate           DateTime
  endDate             DateTime?
  monthlyRent         Decimal              @db.Decimal(12, 2)
  rentDueDay          Int                  @default(1)
  status              LeaseStatus          @default(ACTIVE)
  terminationReason   String?
  depositAmount       Decimal              @default(0) @db.Decimal(12, 2)
  occupants           Int @default(1)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  unit                Unit                 @relation(fields: [unitId], references: [id])
  rentCharges         RentCharge[]
  depositTransactions DepositTransaction[]

  @@index([unitId, status])
  @@index([tenantId, status])
}

  enum RentStatus {
    UNPAID
    PARTIALLY_PAID
    PAID
    OVERDUE
  }

  model RentCharge {
    id          Int        @id @default(autoincrement())
    leaseId     Int
    amount      Decimal
    dueDate     DateTime
    period      String
    status      RentStatus @default(UNPAID)
    createdAt   DateTime   @default(now())
    updatedAt   DateTime   @updatedAt

    lease       Lease      @relation(fields: [leaseId], references: [id])
    payments    Payment[]
  }

  enum PaymentMethod {
    CASH
    MPESA
    BANK_TRANSFER
    CARD
    OTHER
  }

  model Payment {
    id           Int           @id @default(autoincrement())
    rentChargeId Int
    amount       Decimal
    paidAt       DateTime      @default(now())
    method       PaymentMethod
    reference    String?
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @updatedAt

    rentCharge   RentCharge    @relation(fields: [rentChargeId], references: [id])
  }

  model User {
  id           String   @id @default(cuid())
  name         String?
  username     String?  @unique
  email        String?  @unique
  passwordHash String?
  role         String   @default("USER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}